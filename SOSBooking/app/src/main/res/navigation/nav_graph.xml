<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LoginFragment">

    <fragment
        android:id="@+id/LoginFragment"
        android:name="uk.ac.plymouth.hkuspace.sosbooking.LoginFragment"
        android:label="@string/login_top_title"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_to_ForgetPasswordFragment"
            app:destination="@id/ForgetPasswordFragment" />
        <action
            android:id="@+id/action_to_HomeFragment"
            app:destination="@id/HomeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/ForgetPasswordFragment"
        android:name="uk.ac.plymouth.hkuspace.sosbooking.ForgetPasswordFragment"
        android:label="@string/forgetpassword_top_title"
        tools:layout="@layout/fragment_forgetpassword">

    </fragment>
    <fragment
        android:id="@+id/HomeFragment"
        android:name="uk.ac.plymouth.hkuspace.sosbooking.HomeFragment"
        android:label="@string/home_top_title"
        tools:layout="@layout/fragment_home">

    </fragment>
</navigation>